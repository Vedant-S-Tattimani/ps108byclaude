# Copy to backend/.env (never commit .env). The engine runs fully offline without any key.

# --- Optional AI layer: NVIDIA Nemotron via NVIDIA NIM (build.nvidia.com) ---
# Adds translation of any language and re-ranking with reasons. Get a key (starts with nvapi-)
# from build.nvidia.com → any Nemotron model → "Get API Key".
NVIDIA_API_KEY=
ENABLE_LLM=true
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=30

# --- Server ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=5242880
